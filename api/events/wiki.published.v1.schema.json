{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reposense.dev/events/wiki.published.v1.schema.json",
  "title": "wiki.published.v1",
  "type": "object",
  "required": ["event_id", "event_type", "aggregate_id", "occurred_at", "producer", "payload_version", "trace_id", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"const": "wiki.published.v1"},
    "aggregate_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "ai-wiki"},
    "payload_version": {"const": 1},
    "trace_id": {"type": "string"},
    "payload": {
      "type": "object",
      "required": ["job_id", "snapshot_id", "graph_revision_id", "page_ids", "page_count", "locale", "model", "prompt_version", "token_usage"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1},
        "graph_revision_id": {"type": "string", "minLength": 1},
        "page_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "page_count": {"type": "integer", "minimum": 1},
        "locale": {"enum": ["zh-CN", "en-US"]},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "token_usage": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
