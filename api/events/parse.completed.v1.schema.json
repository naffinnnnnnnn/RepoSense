{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reposense.dev/events/parse.completed.v1.schema.json",
  "title": "parse.completed.v1",
  "type": "object",
  "required": ["event_id", "event_type", "aggregate_id", "occurred_at", "producer", "payload_version", "trace_id", "payload"],
  "properties": {
    "event_id": {"type":"string"},
    "event_type": {"const":"parse.completed.v1"},
    "aggregate_id": {"type":"string"},
    "occurred_at": {"type":"string", "format":"date-time"},
    "producer": {"const":"repository-parser"},
    "payload_version": {"const":1},
    "trace_id": {"type":"string"},
    "payload": {
      "type":"object",
      "required":["snapshot_id", "commit_sha", "artifact_count", "relation_count"],
      "properties": {
        "snapshot_id":{"type":"string"}, "commit_sha":{"type":"string"},
        "artifact_count":{"type":"integer", "minimum":0}, "relation_count":{"type":"integer", "minimum":0},
        "deleted_paths":{"type":"array", "items":{"type":"string"}},
        "skipped_count":{"type":"integer", "minimum":0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
